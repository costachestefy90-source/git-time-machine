{
  "name": "git-time-machine",
  "version": "1.0.0",
  "description": "A small local dashboard for exploring Git history",
  "type": "module",
  "bin": {
    "git-time-machine": "./bin/cli.ts"
  },
  "scripts": {
    "dev": "tsx bin/cli.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "tsx bin/cli.ts",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/costachestefy90-source/git-time-machine.git"
  },
